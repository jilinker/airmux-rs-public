# Compose 参数。除了数据库密码，其余默认值通常无需修改。
# 必改：与 config.yaml 中 database.url 的密码一致。
# 默认 Compose 初始化 postgres:5432/airmux，用户 airmux，数据保存在 postgres-data 卷。
# 此密码仅在空数据卷首次初始化时生效，修改它不会重置已有数据库密码。
# 外置 PG 不使用此参数，连接信息只需填写 config.yaml 的 database.url。
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# 可选：替换镜像仓库、版本、访问端口或部署目录。
AIRMUX_IMAGE_REPOSITORY=crpi-bqdmpalw8hu6it5q.cn-shenzhen.personal.cr.aliyuncs.com/jaelinker_public/airmux-rs
AIRMUX_VERSION=v0.2.0
AIRMUX_HTTP_PORT=8080
AIRMUX_HTTP_BIND=0.0.0.0
AIRMUX_DEPLOY_DIR=/srv/airmux

# 在线更新会自动维护镜像覆盖值，无需手动填写。
AIRMUX_APP_IMAGE=
# 可选：只允许 localhost 访问时，把 AIRMUX_HTTP_BIND 改成 127.0.0.1。
# 如修改端口、目录或镜像仓库，同步调整 config.yaml 对应的注释项。

# 外置 PG 可选项（默认部署忽略）。远程 PG 保持以下默认值。
# 同一 Docker 的已有 PG：填写其网络名称，并将 EXTERNAL 改为 true。
AIRMUX_NETWORK_NAME=airmux_default
AIRMUX_NETWORK_EXTERNAL=false
# 仅已有 PG 容器支持在线更新：填写 config.yaml 的 deployment.database_container，
# 保持 updater.enabled: true，再把此值改为 updates；远程 PG 设 enabled: false。
COMPOSE_PROFILES=
