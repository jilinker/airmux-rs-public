# 仅供 Docker Compose 插值 不向 API 注入程序参数
AIRMUX_PROJECT_NAME=airmux
AIRMUX_IMAGE_REPOSITORY=docker.io/jaelinker/airmux
# 新数据库代际从 v0.5.0 开始 旧发行需要独立空库安装
# 后续选择同版发行标签 或在下方填写固定镜像摘要
AIRMUX_VERSION=v0.5.2
AIRMUX_PLATFORM=linux/amd64
AIRMUX_APP_IMAGE=
AIRMUX_UPDATER_IMAGE=
AIRMUX_POSTGRES_IMAGE=postgres:17-bookworm
AIRMUX_HTTP_BIND=0.0.0.0
AIRMUX_HTTP_PORT=8080
AIRMUX_DEPLOY_DIR=/srv/airmux
AIRMUX_CONFIG_FILE=./config.yaml

# 仅首次初始化空数据库卷时使用 应用连接以程序 YAML 为准
POSTGRES_USER=airmux
POSTGRES_DB=airmux
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# 由 Compose 控制是否启动更新器 程序连接另由 YAML 配置
COMPOSE_PROFILES=updates

# 外置数据库模板专用 远程数据库无可备份容器时关闭更新器
AIRMUX_DATABASE_CONTAINER=
AIRMUX_NETWORK_NAME=airmux_default
AIRMUX_NETWORK_EXTERNAL=false
